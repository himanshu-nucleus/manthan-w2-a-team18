# Where the Vite dev server proxies /api requests (the FastAPI backend).
VITE_API_PROXY_TARGET=http://localhost:8000

# Set to "true" to serve API calls from the MSW mocks in src/mocks instead of the backend.
# Mock logins: employee@expenseflow.example, manager@…, auditor@…, admin@… / password "password".
VITE_ENABLE_MOCKS=false
