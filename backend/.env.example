# AI Manthan backend - environment template.
# Copy to `.env` and adjust. `.env` is gitignored; THIS file is the template
# that is committed. Dummy / synthetic values only - never real secrets.

# Running the app on the host (outside Docker): PostgreSQL is published on 5433
# because team laptops may already run a local PostgreSQL on 5432.
# Inside docker compose the api service instead uses host `db` and port 5432.
DATABASE_URL=postgresql+psycopg://manthan:manthan@localhost:5433/manthan

APP_NAME=AI Manthan Backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# Signs login tokens. Dummy value - generate your own for anything shared:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-insecure-secret-key-change-me
ACCESS_TOKEN_TTL_SECONDS=28800

# Receipt uploads: folder (relative to backend/ when run locally), size limit and count limit.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
MAX_ATTACHMENTS_PER_CLAIM=10

# Business time zone for 'today', payout date ranges and value dates.
TIMEZONE=Asia/Kolkata
